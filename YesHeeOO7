-- เพิ่มระบบ Anti-Stun
MainSection:NewToggle("ป้องกันการสตั้น / ตัวแข็ง (Anti-Stun)", "ไม่ติดสตั้น ไม่โดนแช่แข็ง ไม่ล้ม", function(state)
    AntiStunEnabled = state
end)

-- Loop ตรวจสอบสถานะการโดน Stun / Freeze
RunService.Stepped:Connect(function()
    -- Noclip
    if Noclip and LocalPlayer.Character then
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end

    -- Anti-Stun
    if AntiStunEnabled and LocalPlayer.Character then
        local Char = LocalPlayer.Character
        local Hum = Char:FindFirstChildOfClass("Humanoid")
        
        if Hum then
            -- ยกเลิกการ Sit, Ragdoll, PlatformStand
            Hum.PlatformStand = false
            Hum.Sit = false
            
            local badStates = {
                Enum.HumanoidStateType.Ragdoll,
                Enum.HumanoidStateType.FallingDown,
                Enum.HumanoidStateType.Physics
            }
            for _, state in ipairs(badStates) do
                if Hum:GetState() == state then
                    Hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                end
            end
        end

        -- ปลดการ Anchor (ถูกตรึงไม่ให้ขยับ)
        for _, part in pairs(Char:GetChildren()) do
            if part:IsA("BasePart") and part.Anchored then
                part.Anchored = false
            end
            -- ลบพวก Folder หรือ Effect สตั้นต่างๆ
            if part.Name:lower():find("stun") or part.Name:lower():find("freeze") or part.Name:lower():find("disable") then
                part:Destroy()
            end
        end
    end
end)

-- ==================== [ TAB 2: Teleport (วาร์ป) ] ====================
local TP_Tab = Window:NewTab("Teleport")
local TP_Section = TP_Tab:NewSection("ระบบวาร์ป")

TP_Section:NewButton("สุ่มวาร์ปไปหาผู้เล่นอื่น", "วาร์ปไปหาผู้เล่นแบบสุ่ม", function()
    local allPlayers = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            table.insert(allPlayers, p)
        end
    end
    if #allPlayers > 0 then
        local randomPlayer = allPlayers[math.random(1, #allPlayers)]
        LocalPlayer.Character.HumanoidRootPart.CFrame = randomPlayer.Character.HumanoidRootPart.CFrame
    end
end)

TP_Section:NewToggle("โหมดแตะหน้าจอแล้ววาร์ป", "เปิดไว้แล้วแตะที่พื้นเพื่อวาร์ป", function(state)
    TouchTPEnabled = state
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if TouchTPEnabled and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) then
        local Mouse = LocalPlayer:GetMouse()
        if Mouse.Hit and LocalPlayer.Character then
            LocalPlayer.Character:MoveTo(Mouse.Hit.p)
        end
    end
end)

